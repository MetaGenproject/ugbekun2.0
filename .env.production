# Ugbekun 2.0 Frontend - PRODUCTION Environment Variables
# These are used when deployed to Vercel

# Server-side backend URL (used by Next.js API route handlers on Vercel)
BACKEND_API_URL=https://ugbekunsmp-backend.onrender.com

# Public client-side API URL (used by browser — routes through same-origin /api/proxy on production)
NEXT_PUBLIC_API_URL=https://ugbekunsmp-backend.onrender.com/api
